{
  "name": "dripwell-ai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dripwell/web dev",
    "dev:api": "pnpm --filter @dripwell/api dev",
    "dev:admin": "pnpm --filter @dripwell/admin dev",
    "build": "pnpm --filter @dripwell/web build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,html,css}\"",
    "typecheck": "pnpm --filter @dripwell/shared typecheck && pnpm --filter @dripwell/web typecheck",
    "test": "pnpm --filter @dripwell/shared test && pnpm --filter @dripwell/web test",
    "db:generate": "pnpm --filter @dripwell/shared db:generate",
    "db:validate": "pnpm --filter @dripwell/shared db:validate",
    "db:deploy": "pnpm --filter @dripwell/shared exec prisma migrate deploy",
    "check:services": "pnpm --filter @dripwell/web check:services",
    "legacy:build": "pnpm -r build",
    "legacy:typecheck": "pnpm -r typecheck",
    "admin:bootstrap": "pnpm --filter @dripwell/web admin:bootstrap"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
