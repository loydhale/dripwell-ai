# Provision real services in the linked Vercel project and pull into apps/web/.env.local.
# Never put credentials in NEXT_PUBLIC variables. All values here are intentionally empty.
DATABASE_URL=
APP_URL=
AUTH_ENCRYPTION_KEY=
AI_GATEWAY_API_KEY=
AI_MODEL=
TRANSCRIPTION_MODEL=
BLOB_READ_WRITE_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional explicit platform plan overrides, in integer currency minor units.
# Blank uses the canonical starter USD199/month per clinic account.
# Select a matching active monthly licensed Stripe price before enabling checkout.
PLATFORM_SUBSCRIPTION_CENTS=
PLATFORM_SUBSCRIPTION_CURRENCY=
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
# Both inference and transcription use Vercel AI Gateway. Hosted project OIDC can replace AI_GATEWAY_API_KEY.
# Real client processing remains disabled until all relevant service agreements and controls are verified.
ALLOW_REAL_CLIENT_DATA=false
