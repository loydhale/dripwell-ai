generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationType {
  ASSESSMENT_COMPLETED
  PROVIDER_INVITED
  SAFETY_FLAG
  LOW_STOCK
  CARE_OUTCOME_NEEDED
  WELLNESS_DECISION_NEEDED
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_USER
  PROVIDER
  SYSTEM_ADMIN
  STAFF
}

enum ItemType {
  DRIP
  ADD_ON
  INJECTION
  PEPTIDE
}

enum FlagTier {
  T1_INFO
  T2_FOLLOWUP
  T3_URGENT
}

enum QuestionCategory {
  ENERGY_SLEEP
  HYDRATION
  STRESS_RECOVERY
  WOMENS_HEALTH
  DIET_PATTERN
  MEDICAL_HISTORY
  SPECIFIC_SYMPTOMS
  GOALS
}

enum PhotoAngle {
  FACE
  UNDER_EYES
  HAND_FOREARM
  TONGUE
}

enum SignalName {
  CONJUNCTIVAL_PALLOR
  UNDER_EYE_DARKNESS
  UNDER_EYE_PUFFINESS
  SCLERA_TINT
  LIP_DRYNESS
  LIP_PALLOR
  ANGULAR_CHEILITIS
  TONGUE_COLOR
  TONGUE_SURFACE
  FACIAL_DULLNESS
  FACIAL_REDNESS
  SKIN_TEXTURE
  NAIL_BED_COLOR
  NAIL_RIDGING
  NAIL_SPOONING
  HAIR_QUALITY
  POSTURE_AFFECT
}

enum AuditAction {
  ASSESSMENT_CREATED
  ASSESSMENT_COMPLETED
  PHOTO_CAPTURED
  SIGNAL_EXTRACTED
  QUESTION_ANSWERED
  PATTERN_MATCHED
  RECOMMENDATION_GENERATED
  SAFETY_FLAG_RAISED
  PROVIDER_APPROVED
  PROVIDER_OVERRIDDEN
  PROVIDER_ESCALATED
  PROVIDER_DEFERRED
  CONSENT_CAPTURED
  VITALS_RECORDED
  CATALOG_UPDATED
  USER_INVITED
  USER_DEACTIVATED
  SETTINGS_CHANGED
  IMPERSONATION_STARTED
}

enum OverrideReason {
  CLINICAL_JUDGEMENT
  PATIENT_PREFERENCE
  CONTRAINDICATION
  CLINICAL_DISAGREEMENT
  CONTRAINDICATION_RESOLVED
  INSUFFICIENT_DATA
  SAFETY_CONCERN
  OTHER
}

enum RecommendationStatus {
  PENDING
  APPROVED
  MODIFIED
  REJECTED
}

enum AssessmentStatus {
  IN_PROGRESS
  PENDING_REVIEW
  APPROVED
  OVERRIDDEN
  ESCALATED
  DEFERRED
  COMPLETED
  ABANDONED
}

// ---------------------------------------------------------------------------
// Multi-tenant tables
// ---------------------------------------------------------------------------

model Tenant {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  state           String
  medicalDirector String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  referralCode    String?  @unique

  locations            Location[]
  users                User[]
  assessmentSessions   AssessmentSession[]
  catalogItems         CatalogItem[]
  auditLogs            AuditLog[]
  patientIntakes       PatientIntake[]
  photoCaptures        PhotoCapture[]
  visualSignals        VisualSignal[]
  questionAnswers      QuestionAnswer[]
  patternMatches       PatternMatch[]
  recommendations      Recommendation[]
  safetyFlags          SafetyFlag[]
  providerOverrides    ProviderOverride[]
  assessmentHistories  AssessmentHistory[]
  catalogItemCompatibilities CatalogItemCompatibility[]
  config               Json?    @default("{}")
  notifications        Notification[]
  changeLogs           AssessmentChangeLog[]
  feedbacks            Feedback[]
  configurationVersions      ClinicConfigurationVersion[]
  consultations              Consultation[]
  consultationRevisions      ConsultationRevision[]
  consultationEvents         ConsultationEvent[]
  consultationAdjustments    ConsultationAdjustment[]
  subscription               Subscription?
  trialUsage                 TrialUsage[]
  referralsSent              Referral[]                   @relation("ReferrerTenant")
  referralReceived           Referral?                    @relation("ReferredTenant")
  credits                    CreditLedger[]
  takeaways                  Takeaway[]
  shareLinks                 ShareLink[]
  invites                    UserInvite[]
  setupConversations         SetupConversation[]
  generationJobs             GenerationJob[]
  recordingSegments          RecordingSegment[]
  improvementProposals       ImprovementProposal[]
  agentContextSnapshots      AgentContextSnapshot[]

  @@index([slug])
  @@index([isActive])
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessmentSessions AssessmentSession[]
  configurationVersions ClinicConfigurationVersion[]
  consultations         Consultation[]
  setupConversations    SetupConversation[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// User tables
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String?   @db.Uuid
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole
  isActive      Boolean   @default(true)
  mfaEnabled    Boolean   @default(false)
  canApproveClinical        Boolean   @default(false)
  mfaSecretEncrypted        String?
  mfaRecoveryHashes         Json?     @default("[]")
  mfaPendingSecretEncrypted String?
  mfaPendingExpiresAt       DateTime?
  mfaLastUsedStep           Int?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assessmentSessions       AssessmentSession[]
  recommendations          Recommendation[]
  safetyFlagsAcknowledged  SafetyFlag[]         @relation("AcknowledgedBy")
  providerOverrides        ProviderOverride[]
  auditLogs                AuditLog[]
  changeLogs               AssessmentChangeLog[]
  feedbacksSubmitted       Feedback[]
  authSessions            AuthSession[]
  authChallenges          AuthChallenge[]
  agentContextSnapshots   AgentContextSnapshot[] @relation("AgentContextUser")
  consultations           Consultation[]         @relation("ConsultationProvider")

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([email])
  @@index([role])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Anonymous patient model
// ---------------------------------------------------------------------------

model AssessmentSession {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId      String?           @db.Uuid
  location        Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  providerId      String            @db.Uuid
  provider        User              @relation(fields: [providerId], references: [id], onDelete: Restrict)
  anonymousToken  String?           @unique
  isReturning     Boolean           @default(false)
  priorSessionId  String?           @db.Uuid
  priorSession    AssessmentSession? @relation("SessionHistory", fields: [priorSessionId], references: [id], onDelete: SetNull)
  followUpSessions AssessmentSession[] @relation("SessionHistory")
  status          AssessmentStatus  @default(IN_PROGRESS)
  vitals          Json?
  consent         Json?
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patientIntake       PatientIntake?
  photoCaptures       PhotoCapture[]
  visualSignals       VisualSignal[]
  questionAnswers     QuestionAnswer[]
  patternMatches      PatternMatch[]
  recommendations     Recommendation[]
  safetyFlags         SafetyFlag[]
  providerOverrides   ProviderOverride[]
  assessmentHistories AssessmentHistory[] @relation("HistorySession")
  baselineHistories   AssessmentHistory[] @relation("HistoryBaseline")
  auditLogs           AuditLog[]
  changeLogs          AssessmentChangeLog[]

  @@index([tenantId])
  @@index([providerId])
  @@index([anonymousToken])
  @@index([status])
  @@index([createdAt])
  @@index([priorSessionId])
}

model PatientIntake {
  id                 String   @id @default(uuid()) @db.Uuid
  assessmentSessionId String  @unique @db.Uuid
  assessmentSession  AssessmentSession @relation(fields: [assessmentSessionId], references: [id], onDelete: Cascade)
  tenantId           String   @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medications        Json?
  conditions         Json?
  allergies          Json?
  menstrualStatus    String?
  recentIllness      String?
  supplements        Json?
  visitGoals         Json?
  isFromOcr          Boolean  @default(false)
  ocrConfidence      Float?
  providerVerifiedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@index([assessmentSessionId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Assessment flow tables
// ---------------------------------------------------------------------------

model PhotoCapture {
  id                 String   @id @default(uuid()) @db.Uuid
  assessmentSessionId String  @db.Uuid
  assessmentSession  AssessmentSession @relation(fields: [assessmentSessionId], references: [id], onDelete: Cascade)
  tenantId           String   @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  angle              PhotoAngle
  url                String
  capturedAt         DateTime @default(now())
  uploadedAt         DateTime?
  isOfflineSync      Boolean  @default(false)
  createdAt          DateTime @default(now())

  visualSignals VisualSignal[]

  @@index([tenantId])
  @@index([assessmentSessionId])
  @@index([createdAt])
}

model VisualSignal {
  id                 String   @id @default(uuid()) @db.Uuid
  assessmentSessionId String  @db.Uuid
  assessmentSession  AssessmentSession @relation(fields: [assessmentSessionId], references: [id], onDelete: Cascade)
  tenantId           String   @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  photoCaptureId     String?  @db.Uuid
  photoCapture       PhotoCapture? @relation(fields: [photoCaptureId], references: [id], onDelete: SetNull)
  signalName         SignalName
  confidence         Float
  value              String?
  rawJson            Json?
  extractedAt        DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([tenantId])
  @@index([assessmentSessionId])
  @@index([photoCaptureId])
  @@index([signalName])
  @@index([createdAt])
}

model QuestionAnswer {
  id                 String   @id @default(uuid()) @db.Uuid
  assessmentSessionId String  @db.Uuid
  assessmentSession  AssessmentSession @relation(fields: [assessmentSessionId], references: [id], onDelete: Cascade)
  tenantId           String   @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questionBankId     String   @db.Uuid
  questionBank       QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Restrict)
  questionText       String
  answerValue        String
  answerType         String
  confidenceDelta    Float?
  answeredAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([tenantId])
  @@index([assessmentSessionId])
  @@index([questionBankId])
  @@index([createdAt])
}

model PatternMatch {
  id                 String   @id @default(uuid()) @db.Uuid
  assessmentSessionId String  @db.Uuid
  assessmentSession  AssessmentSession @relation(fields: [assessmentSessionId], references: [id], onDelete: Cascade)
  tenantId           String   @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicalPatternId  String   @db.Uuid
  clinicalPattern    ClinicalPattern @relation(fields: [clinicalPatternId], references: [id], onDelete: Restrict)
  confidence         Float
  matchedSignals     Json
  matchedAnswers     Json
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([tenantId])
  @@index([assessmentSessionId])
  @@index([clinicalPatternId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Recommendation tables
// ---------------------------------------------------------------------------

model Recommendation {
  id                  String   @id @default(uuid()) @db.Uuid
  assessmentSessionId String  @db.Uuid
  assessmentSession   AssessmentSession @relation(fields: [assessmentSessionId], references: [id], onDelete: Cascade)
  tenantId            String   @db.Uuid
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerId          String   @db.Uuid
  provider            User     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  status              RecommendationStatus @default(PENDING)
  primaryCatalogItemId String  @db.Uuid
  primaryItem         CatalogItem @relation("PrimaryRecommendationItem", fields: [primaryCatalogItemId], references: [id], onDelete: Restrict)
  rationale           String
  confidence          Float
  approvedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  safetyFlags        SafetyFlag[]
  providerOverrides  ProviderOverride[]
  recommendationItems RecommendationItem[]

  @@index([tenantId])
  @@index([assessmentSessionId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}

model RecommendationItem {
  id               String   @id @default(uuid()) @db.Uuid
  recommendationId String   @db.Uuid
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  catalogItemId    String   @db.Uuid
  catalogItem      CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  isPrimary        Boolean  @default(false)
  dosageNote       String?
  createdAt        DateTime @default(now())

  @@index([recommendationId])
  @@index([catalogItemId])
}

model SafetyFlag {
  id                      String   @id @default(uuid()) @db.Uuid
  assessmentSessionId     String   @db.Uuid
  assessmentSession       AssessmentSession @relation(fields: [assessmentSessionId], references: [id], onDelete: Cascade)
  tenantId                String   @db.Uuid
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recommendationId        String?  @db.Uuid
  recommendation          Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  tier                    FlagTier
  flagType                String
  description             String
  suggestedScript         String?
  providerAcknowledgedAt  DateTime?
  providerAcknowledgedById String? @db.Uuid
  providerAcknowledgedBy  User?    @relation("AcknowledgedBy", fields: [providerAcknowledgedById], references: [id], onDelete: SetNull)
  isOverridden            Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  providerOverrides ProviderOverride[]

  @@index([tenantId])
  @@index([assessmentSessionId])
  @@index([recommendationId])
  @@index([tier])
  @@index([createdAt])
}

model ProviderOverride {
  id                  String   @id @default(uuid()) @db.Uuid
  assessmentSessionId String   @db.Uuid
  assessmentSession   AssessmentSession @relation(fields: [assessmentSessionId], references: [id], onDelete: Cascade)
  tenantId            String   @db.Uuid
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerId          String   @db.Uuid
  provider            User     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  recommendationId    String?  @db.Uuid
  recommendation      Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  safetyFlagId        String?  @db.Uuid
  safetyFlag          SafetyFlag? @relation(fields: [safetyFlagId], references: [id], onDelete: SetNull)
  overrideType        String
  reason              OverrideReason
  reasonNote          String?
  originalValue       String?
  newValue            String?
  createdAt           DateTime @default(now())

  @@index([tenantId])
  @@index([assessmentSessionId])
  @@index([providerId])
  @@index([recommendationId])
  @@index([safetyFlagId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Clinical pattern library (universal / cross-tenant)
// ---------------------------------------------------------------------------

model ClinicalPattern {
  id                         String   @id @default(uuid()) @db.Uuid
  name                       String   @unique
  description                String
  category                   String
  supportingSignals          Json
  supportingAnswers          Json
  conflictingSignals         Json
  genericRecommendationIntent String
  clinicalRationale          String
  safetyFlags                Json
  isActive                   Boolean  @default(true)
  version                    Int      @default(1)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  patternMatches PatternMatch[]

  @@index([category])
  @@index([isActive])
}

model SignalTaxonomy {
  id            String   @id @default(uuid()) @db.Uuid
  name          SignalName @unique
  displayName   String
  description   String
  bodyRegion    String
  dataType      String
  possibleValues Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model QuestionBank {
  id                   String   @id @default(uuid()) @db.Uuid
  category             QuestionCategory
  questionText         String
  answerType           String
  answerOptions        Json?
  informationGainWeight Float?
  followUpQuestions    Json?
  isActive             Boolean  @default(true)
  version              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  questionAnswers QuestionAnswer[]

  @@index([category])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Catalog tables
// ---------------------------------------------------------------------------

model CatalogItem {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  description           String?
  aiGeneratedDescription Boolean  @default(false)
  type                  ItemType
  isActive              Boolean  @default(true)
  isInStock             Boolean  @default(true)
  outOfStockReason      String?
  priceCents             Int?
  currency               String   @default("USD")
  stateRestrictions     Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  ingredients              CatalogItemIngredient[]
  compatibilitiesAsBase    CatalogItemCompatibility[] @relation("BaseItem")
  compatibilitiesAsCompatible CatalogItemCompatibility[] @relation("CompatibleItem")
  primaryRecommendations   Recommendation[] @relation("PrimaryRecommendationItem")
  recommendationItems      RecommendationItem[]

  @@index([tenantId])
  @@index([type])
  @@index([isActive])
  @@index([isInStock])
}

model Ingredient {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  catalogItems CatalogItemIngredient[]

  @@index([isActive])
}

model CatalogItemIngredient {
  id            String   @id @default(uuid()) @db.Uuid
  catalogItemId String   @db.Uuid
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  ingredientId  String   @db.Uuid
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  dosage        String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([catalogItemId])
  @@index([ingredientId])
  @@unique([catalogItemId, ingredientId])
}

model CatalogItemCompatibility {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseItemId        String   @db.Uuid
  baseItem          CatalogItem @relation("BaseItem", fields: [baseItemId], references: [id], onDelete: Cascade)
  compatibleItemId  String   @db.Uuid
  compatibleItem    CatalogItem @relation("CompatibleItem", fields: [compatibleItemId], references: [id], onDelete: Cascade)
  isDefault         Boolean  @default(false)
  maxQuantity       Int?
  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@index([baseItemId])
  @@index([compatibleItemId])
  @@unique([baseItemId, compatibleItemId])
}

// ---------------------------------------------------------------------------
// Audit / log tables
// ---------------------------------------------------------------------------

model AuditLog {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String?  @db.Uuid
  tenant              Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId              String?  @db.Uuid
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  impersonatedBy      String?  @db.Uuid
  assessmentSessionId String?  @db.Uuid
  assessmentSession   AssessmentSession? @relation(fields: [assessmentSessionId], references: [id], onDelete: SetNull)
  action              AuditAction
  entityType          String
  entityId            String?  @db.Uuid
  details             Json?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([impersonatedBy])
  @@index([assessmentSessionId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model AssessmentHistory {
  id                  String   @id @default(uuid()) @db.Uuid
  assessmentSessionId String   @db.Uuid
  assessmentSession   AssessmentSession @relation(name: "HistorySession", fields: [assessmentSessionId], references: [id], onDelete: Cascade)
  tenantId            String   @db.Uuid
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baselineSessionId   String?  @db.Uuid
  baselineSession     AssessmentSession? @relation(name: "HistoryBaseline", fields: [baselineSessionId], references: [id], onDelete: SetNull)
  eventType           String
  description         String
  metadata            Json?
  createdAt           DateTime @default(now())

  @@index([tenantId])
  @@index([assessmentSessionId])
  @@index([baselineSessionId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  isRead    Boolean  @default(false)
  entityId  String?  @db.Uuid
  createdAt DateTime @default(now())
  userId         String?          @db.Uuid
  consultationId String?          @db.Uuid
  consultation   Consultation?    @relation(fields: [consultationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  idempotencyKey String?          @unique
  dueAt          DateTime?
  dismissedAt    DateTime?

  @@index([tenantId])
  @@index([isRead])
  @@index([createdAt])
}

model AssessmentChangeLog {
  id                  String   @id @default(uuid()) @db.Uuid
  assessmentSessionId String   @db.Uuid
  assessmentSession   AssessmentSession @relation(fields: [assessmentSessionId], references: [id], onDelete: Cascade)
  tenantId            String   @db.Uuid
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerId          String   @db.Uuid
  provider            User     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  actionType          String
  originalValue       Json?
  modifiedValue       Json?
  changedFields       Json?
  providerName        String
  createdAt           DateTime @default(now())

  @@index([tenantId])
  @@index([assessmentSessionId])
  @@index([providerId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Feedback tables
// ---------------------------------------------------------------------------

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  GENERAL
}

enum FeedbackStatus {
  BACKLOG
  IN_PROGRESS
  DONE
  WONT_DO
}

enum FeedbackCategory {
  SOFTWARE_ISSUE
  PROCESS_ISSUE
  DOCUMENTATION
  OTHER
}

enum FeedbackDecision {
  DO_IT
  DONT_DO_IT
  MAYBE
  NEEDS_MORE_INFO
}

enum FeedbackPriority {
  P0
  P1
  P2
}

model Feedback {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submitterId     String           @db.Uuid
  submitter       User             @relation(fields: [submitterId], references: [id], onDelete: Restrict)
  type            FeedbackType
  title           String
  description     String
  urgency         String
  status          FeedbackStatus   @default(BACKLOG)
  category        FeedbackCategory?
  decision        FeedbackDecision?
  priority        FeedbackPriority?
  assignedTo      String?          @db.Uuid
  notes           String?
  promotedTaskId  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// V2 consultation workflow. All clinical records stay tenant scoped.
// ---------------------------------------------------------------------------

enum ConfigurationStatus {
  DRAFT
  TESTED
  ACTIVE
  RETIRED
}

enum ConsultationStage {
  CONSULTATION_STARTED
  INITIAL_RECOMMENDATIONS_GIVEN
  WELLNESS_RECOMMENDATIONS_PRODUCED
  WELLNESS_RECOMMENDATIONS_ACCEPTED
  WELLNESS_RECOMMENDATIONS_REJECTED
  WELLNESS_RECOMMENDATION_TBD
}

enum CareOutcome {
  PENDING
  STARTED
  NOT_STARTED
}

enum WellnessDecision {
  ACCEPTED
  REJECTED
  TBD
}

model ClinicConfigurationVersion {
  id                    String                 @id @default(uuid()) @db.Uuid
  tenantId              String                 @db.Uuid
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId            String                 @db.Uuid
  location              Location               @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  version               Int
  revision              Int                    @default(1)
  status                ConfigurationStatus    @default(DRAFT)
  payload               Json
  source                String
  userId                String                 @db.Uuid
  clinicalValidatedById String?                @db.Uuid
  tests                 Json                   @default("[]")
  activatedAt           DateTime?
  activatedById         String?                @db.Uuid
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  consultations         Consultation[]
  improvements          ImprovementProposal[]
  agentContextSnapshots AgentContextSnapshot[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, locationId])
  @@unique([tenantId, locationId, version])
  @@index([tenantId, locationId, status])
}

model Consultation {
  id                       String                     @id @default(uuid()) @db.Uuid
  tenantId                 String                     @db.Uuid
  tenant                   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId               String                     @db.Uuid
  location                 Location                   @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  providerId               String                     @db.Uuid
  provider                 User                       @relation("ConsultationProvider", fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  configurationVersionId   String                     @db.Uuid
  configurationVersion     ClinicConfigurationVersion @relation(fields: [configurationVersionId, tenantId, locationId], references: [id, tenantId, locationId], onDelete: Restrict)
  reference                String
  idempotencyKey           String
  isTest                   Boolean                    @default(false)
  stage                    ConsultationStage          @default(CONSULTATION_STARTED)
  version                  Int                        @default(1)
  consentAt                DateTime?
  consentDeclined          Boolean                    @default(false)
  transcript               Json                       @default("[]")
  summary                  Json                       @default("{}")
  summaryRevision          Int                        @default(1)
  initialRecommendation    Json?
  initialRevision          Int                        @default(0)
  initialSummaryRevision   Int?
  clinicalApprovedVersion  Int?
  clinicalApprovedById     String?                    @db.Uuid
  clinicalApprovedAt       DateTime?
  actualCare               Json?
  careRevision             Int                        @default(0)
  careOutcome              CareOutcome                @default(PENDING)
  wellnessPlan             Json?
  wellnessRevision         Int                        @default(0)
  wellnessSummaryRevision  Int?
  wellnessCareRevision     Int?
  wellnessApprovedVersion  Int?
  wellnessApprovedById     String?                    @db.Uuid
  wellnessApprovedAt       DateTime?
  wellnessDecision         WellnessDecision?
  wellnessDecisionRevision Int?
  archivedAt               DateTime?
  archivedById             String?                    @db.Uuid
  archiveReason            String?
  completedAt              DateTime?
  careOutcomeDueAt         DateTime?
  wellnessDecisionDueAt    DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  revisions     ConsultationRevision[]
  events        ConsultationEvent[]
  adjustments   ConsultationAdjustment[]
  trialUsage    TrialUsage?
  takeaways     Takeaway[]
  jobs          GenerationJob[]
  recordings    RecordingSegment[]
  notifications Notification[]

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, reference])
  @@index([tenantId, stage, archivedAt])
  @@index([tenantId, providerId, createdAt])
  @@index([tenantId, careOutcomeDueAt])
  @@index([tenantId, wellnessDecisionDueAt])
}

model ConsultationRevision {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consultationId String       @db.Uuid
  consultation   Consultation @relation(fields: [consultationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  kind           String
  revision       Int
  payload        Json
  original       Boolean      @default(false)
  userId         String?      @db.Uuid
  reason         String?
  promptVersion  String?
  model          String?
  createdAt      DateTime     @default(now())

  @@unique([consultationId, kind, revision])
  @@index([tenantId, consultationId, createdAt])
}

model ConsultationEvent {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consultationId   String       @db.Uuid
  consultation     Consultation @relation(fields: [consultationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  userId           String?      @db.Uuid
  action           String
  before           Json?
  after            Json?
  reason           String?
  artifactRevision Int?
  idempotencyKey   String?      @unique
  createdAt        DateTime     @default(now())

  @@index([tenantId, consultationId, createdAt])
  @@index([tenantId, action, createdAt])
}

model ConsultationAdjustment {
  id                  String       @id @default(uuid()) @db.Uuid
  tenantId            String       @db.Uuid
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consultationId      String       @db.Uuid
  consultation        Consultation @relation(fields: [consultationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  userId              String       @db.Uuid
  kind                String
  revision            Int
  before              Json
  after               Json
  changedFields       Json
  reason              String
  note                String?
  ownerClassification String?
  ownerReviewedById   String?      @db.Uuid
  ownerReviewedAt     DateTime?
  createdAt           DateTime     @default(now())

  @@index([tenantId, consultationId, createdAt])
  @@index([tenantId, ownerClassification, createdAt])
}

model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @unique @db.Uuid
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status               String    @default("NOT_STARTED")
  trialActivatedAt     DateTime?
  trialEndsAt          DateTime?
  trialLimit           Int       @default(10)
  trialUsed            Int       @default(0)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  lastStripeEventAt    DateTime?
  stripeStatus         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model TrialUsage {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consultationId String       @unique @db.Uuid
  consultation   Consultation @relation(fields: [consultationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  idempotencyKey String
  createdAt      DateTime     @default(now())

  @@unique([tenantId, idempotencyKey])
  @@unique([consultationId, tenantId])
}

model Referral {
  id                  String         @id @default(uuid()) @db.Uuid
  referrerTenantId    String         @db.Uuid
  referrerTenant      Tenant         @relation("ReferrerTenant", fields: [referrerTenantId], references: [id], onDelete: Restrict)
  referredTenantId    String         @unique @db.Uuid
  referredTenant      Tenant         @relation("ReferredTenant", fields: [referredTenantId], references: [id], onDelete: Restrict)
  code                String
  policyVersion       Int?
  policySnapshot      Json?
  qualifyingInvoiceId String?        @unique
  attributedAt        DateTime       @default(now())
  convertedAt         DateTime?
  status              String         @default("ATTRIBUTED")
  createdAt           DateTime       @default(now())
  credits             CreditLedger[]
}

model CreditLedger {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  referralId          String?   @db.Uuid
  referral            Referral? @relation(fields: [referralId], references: [id], onDelete: Restrict)
  kind                String
  amountCents         Int
  currency            String
  policyVersion       Int
  sourceEventId       String    @unique
  stripeTransactionId String?   @unique
  reversesId          String?   @db.Uuid
  createdAt           DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([referralId, kind])
}

model PlatformPolicy {
  id             String   @id @default("global")
  name           String?
  referralPolicy Json?
  updatedById    String?  @db.Uuid
  updatedAt      DateTime @updatedAt
}

model BillingEvent {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @unique
  eventType    String
  eventCreated DateTime
  payload      Json?
  processedAt  DateTime?
  status       String    @default("RECEIVED")
  errorCode    String?
  createdAt    DateTime  @default(now())
}

model Takeaway {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consultationId   String       @db.Uuid
  consultation     Consultation @relation(fields: [consultationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  wellnessRevision Int
  payload          Json
  contentHash      String
  createdById      String       @db.Uuid
  createdAt        DateTime     @default(now())
  revokedAt        DateTime?
  expiresAt        DateTime?
  shares           ShareLink[]

  @@unique([id, tenantId])
  @@unique([consultationId, wellnessRevision])
}

model ShareLink {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @db.Uuid
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  takeawayId          String              @db.Uuid
  takeaway            Takeaway            @relation(fields: [takeawayId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tokenHash           String              @unique
  recipientEmail      String
  createdById         String              @db.Uuid
  expiresAt           DateTime
  revokedAt           DateTime?
  lastCodeSentAt      DateTime?
  codeSendWindowStart DateTime?
  codeSendCount       Int                 @default(0)
  createdAt           DateTime            @default(now())
  verifications       ShareVerification[]
  sessions            ShareSession[]

  @@index([tenantId, takeawayId])
}

model ShareVerification {
  id            String    @id @default(uuid()) @db.Uuid
  shareLinkId   String    @db.Uuid
  shareLink     ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  codeHash      String
  challengeHash String?   @unique
  expiresAt     DateTime
  attempts      Int       @default(0)
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([shareLinkId, createdAt])
}

model ShareSession {
  id          String    @id @default(uuid()) @db.Uuid
  shareLinkId String    @db.Uuid
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  mfaVerifiedAt DateTime?
}

model AuthChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  purpose    String    @default("LOGIN")
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
}

model UserInvite {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email              String
  role               UserRole  @default(STAFF)
  canApproveClinical Boolean   @default(false)
  tokenHash          String    @unique
  invitedById        String    @db.Uuid
  expiresAt          DateTime
  acceptedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([tenantId, email])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
}

// No automatic insertion, backfill or start. One trusted environment scope owns
// manual and scheduled database maintenance, independently of client tenants.
model MaintenanceCoordinator {
  key                 String   @id
  projectId           String
  environment         String
  branch              String
  deploymentId        String?
  enabled             Boolean  @default(false)
  mode                String   @default("DISABLED")
  phase               String   @default("IDLE")
  generation          BigInt   @default(0)
  ordinal             BigInt   @default(0)
  claimToken          String?  @db.Uuid
  ownerRunId          String?
  dispatchedRunId     String?
  dispatchAttemptedAt DateTime?
  claimedAt           DateTime?
  leaseUntil          DateTime?
  anchorAt            DateTime?
  nextDueAt           DateTime?
  cadenceMs           Int      @default(900000)
  cursors             Json     @default("{}")
  progress            Json     @default("{}")
  continuation        Json?
  lastCompletedAt     DateTime?
  lastErrorCode       String?
  skippedSlots        BigInt   @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SetupConversation {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId   String?            @db.Uuid
  location     Location?          @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  userId       String             @db.Uuid
  messages     Json               @default("[]")
  eveSessionId String?
  draft        Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  recordings   RecordingSegment[]

  @@unique([id, tenantId])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, userId, locationId, updatedAt])
}

model GenerationJob {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consultationId String?       @db.Uuid
  consultation   Consultation? @relation(fields: [consultationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  userId         String        @db.Uuid
  kind           String
  status         String        @default("PENDING")
  runId          String?
  idempotencyKey String
  model          String
  promptVersion  String
  result         Json?
  usage          Json?
  errorCode      String?
  expiresAt      DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
}

model RecordingSegment {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @db.Uuid
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consultationId      String?            @db.Uuid
  consultation        Consultation?      @relation(fields: [consultationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  setupConversationId String?            @db.Uuid
  setupConversation   SetupConversation? @relation(fields: [setupConversationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  userId              String             @db.Uuid
  segmentKey          String
  sequence            Int
  blobPath            String
  mimeType            String
  bytes               Int
  durationSeconds     Float?
  consentAt           DateTime
  status              String             @default("UPLOADED")
  transcript          String?
  staffTranscript     String?
  expiresAt           DateTime
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([tenantId, segmentKey])
  @@unique([consultationId, sequence])
  @@index([tenantId, expiresAt])
}

model ImprovementProposal {
  id                     String                     @id @default(uuid()) @db.Uuid
  tenantId               String                     @db.Uuid
  tenant                 Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  configurationVersionId String                     @db.Uuid
  configurationVersion   ClinicConfigurationVersion @relation(fields: [configurationVersionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  title                  String
  classification         String
  evidence               Json
  proposedPayload        Json
  tests                  Json                       @default("[]")
  status                 String                     @default("PROPOSED")
  userId                 String                     @db.Uuid
  reviewedById           String?                    @db.Uuid
  reviewedAt             DateTime?
  reviewNote             String?
  activatedVersionId     String?                    @db.Uuid
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([tenantId, status, createdAt])
}

model AgentContextSnapshot {
  scopeKey        String                      @id
  tenantId        String                      @db.Uuid
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String                      @db.Uuid
  user            User                        @relation("AgentContextUser", fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  configVersionId String?                     @db.Uuid
  configVersion   ClinicConfigurationVersion? @relation(fields: [configVersionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  context         Json
  updatedAt       DateTime                    @updatedAt

  @@index([tenantId, userId])
}
